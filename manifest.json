{
  "name": "TweetArchive",
  "description": "Archive for tweets you've seen on your timeline so you don't loose them.",
  "version": "0.1",
  "manifest_version": 3,
  "permissions": ["storage", "unlimitedStorage"],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.js",
    "scripts": ["scripts/background.js"]
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "js": ["scripts/readfeed.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": ["scripts/relay.js"],
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "archive/index.html",
        "archive/script.js",
        "archive/style.css"
      ],
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "extension_ids": []
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tweetarchive@asobinin.space",
      "strict_min_version": "128.0"
    }
  }
}
